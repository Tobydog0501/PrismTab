{
  "manifest_version": 3,
  "name": "PrismTab",
  "version": "0.0.0",
  "description": "Google Chrome New Tab extension with liquid glass aesthetics, custom widgets workshop, and advanced customization.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab/newtab.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "sandbox": {
    "pages": [
      "src/shared/sandbox/sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/sandbox/sandbox.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
