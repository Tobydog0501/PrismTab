{
  "manifest_version": 3,
  "name": "PrismTab",
  "version": "1.0.0",
  "description": "A highly customizable New Tab extension focused on a pure desktop experience.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/newtab.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "sandbox": {
    "pages": [
      "src/shared/sandbox/sandbox.html"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prismtab@yourdomain.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
